{
  "name": "luxestay-monorepo",
  "version": "0.2.0",
  "private": true,
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@luxestay/web...",
    "dev:api": "turbo run dev --filter=@luxestay/api...",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "npm run db:migrate --workspace=@luxestay/api",
    "db:seed": "npm run db:seed --workspace=@luxestay/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9",
    "turbo": "^2.5.0",
    "typescript": "^5",
    "typescript-eslint": "^8.72.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}

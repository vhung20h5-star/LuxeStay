{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "apps/web",
      "framework": "nextjs",
      "buildCommand": "cd ../.. && npx turbo run build --filter=@luxestay/web...",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "API_BASE_URL"
        }
      ]
    },
    "backend": {
      "root": "apps/api",
      "framework": "hono",
      "entrypoint": "src/server.ts",
      "buildCommand": "cd ../.. && npx turbo run build --filter=@luxestay/api..."
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}

# Data mode: "api" (calls apps/api with strict errors) | "mock" (standalone seed mode)
NEXT_PUBLIC_DATA_MODE=api
# Use http://localhost:4000 locally, or "/" for same-origin Vercel Services deployments
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Optional server-side override (auto-injected by Vercel Service Binding in production)
API_BASE_URL=http://localhost:4000

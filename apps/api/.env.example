PORT=4000
CORS_ORIGINS=http://localhost:3000
NODE_ENV=development

# Storage driver: "memory" (in-memory/seed) | "database" (PostgreSQL 16 + Drizzle ORM)
STORAGE_DRIVER=memory
# Required when STORAGE_DRIVER=database (matches root docker-compose.yml):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5434/luxestay

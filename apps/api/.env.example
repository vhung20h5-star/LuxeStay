PORT=4000
CORS_ORIGINS=http://localhost:3000
NODE_ENV=development

# Storage driver: "memory" (in-memory/seed) | "database" (PostgreSQL 16 / Neon + Drizzle ORM)
STORAGE_DRIVER=memory
# Required when STORAGE_DRIVER=database (matches root docker-compose.yml or Neon Marketplace):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5434/luxestay
# Optional direct unpooled URL preferred by `npm run db:migrate` on Neon:
# DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-host.neon.tech/neondb?sslmode=require

# Phase 2 Auth, Payment Sandbox & Notifications
SESSION_TTL_DAYS=7
# Required when NODE_ENV=production (use >= 32 random chars in Vercel Env Vars):
PAYMENT_WEBHOOK_SECRET=luxestay-dev-webhook-secret-change-in-prod
PAYMENT_SANDBOX_ENABLED=true
# Optional external email webhook URL for forwarding booking emails:
# NOTIFICATION_WEBHOOK_URL=https://hooks.example.com/email

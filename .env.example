# ============================================
# LuxeStay Monorepo Environment Example
# Copy the relevant variables to apps/api/.env and apps/web/.env.local
# ============================================

# --- Backend API (apps/api) ---
PORT=4000
CORS_ORIGINS=http://localhost:3000
NODE_ENV=development
STORAGE_DRIVER=memory
# DATABASE_URL=postgresql://postgres:postgres@localhost:5434/luxestay
SESSION_TTL_DAYS=7
PAYMENT_WEBHOOK_SECRET=luxestay-dev-webhook-secret-change-in-prod
PAYMENT_SANDBOX_ENABLED=true
# NOTIFICATION_WEBHOOK_URL=https://hooks.example.com/email

# --- Frontend Web (apps/web) ---
# Data mode: "api" (calls apps/api, strict errors) | "mock" (standalone seed adapter)
NEXT_PUBLIC_DATA_MODE=api
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Optional server-side override (e.g., internal Docker/network URL)
API_BASE_URL=http://localhost:4000
